# Optional developer-only local setup. Hosted users enter the API key in ChatGPT Sites Settings.
# Never put real secrets in this file, the browser, README, or Git.
OPENAI_API_KEY=
VERA_MODEL=gpt-6.1-sol
VERA_REASONING_EFFORT=medium
VERA_EMBEDDING_MODEL=text-embedding-3-small
VERA_MAX_OUTPUT_TOKENS=8192
VERA_DAILY_REQUEST_LIMIT=100
VERA_DAILY_TOKEN_LIMIT=1000000
VERA_SESSION_REQUEST_LIMIT=30
VERA_SESSION_TOKEN_LIMIT=300000
# Hosting provisions these privately; nontechnical users do not need to enter them.
VERA_SESSION_SECRET=
VERA_SETUP_TOKEN=
VERA_OWNER_EMAIL=
