# Local development only. Copy to .env (git-ignored) and fill in. Never commit .env or paste keys anywhere else.
# Hosted site: enter ANTHROPIC_API_KEY as a secret in the hosting settings instead.
ANTHROPIC_API_KEY=
VERA_MODEL=claude-sonnet-5-5
VERA_MAX_OUTPUT_TOKENS=8192
VERA_DAILY_REQUEST_LIMIT=100
VERA_DAILY_TOKEN_LIMIT=1000000
VERA_SESSION_REQUEST_LIMIT=30
VERA_SESSION_TOKEN_LIMIT=300000
# Hosting provisions these privately.
VERA_SESSION_SECRET=
VERA_SETUP_TOKEN=
VERA_OWNER_EMAIL=
